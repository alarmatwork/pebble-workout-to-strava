#
# Build rules for the Pebble app.
#
import json
import os.path

top = '.'
out = 'build'

SPORT_TYPES_JSON = 'src/pkjs/sport_types.json'
SPORT_TYPES_HEADER = 'src/c/sport_types.auto.h'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    ctx.load('pebble_sdk')


def generate_sport_types_header(ctx):
    """Writes the watch's sport type table from the JSON list the phone uses."""
    src = ctx.path.find_node(SPORT_TYPES_JSON).abspath()
    with open(src) as f:
        sports = json.load(f)
    lines = [
        '// Generated by wscript from ' + SPORT_TYPES_JSON + '. Do not edit.',
        '#pragma once',
        '#include "sports.h"',
        '',
        'static const SportType SPORT_TYPES[] = {',
    ]
    for sport in sports:
        lines.append('  {{{}, {}}},'.format(json.dumps(sport['id']), json.dumps(sport['name'])))
    lines += ['};', '']
    content = '\n'.join(lines)
    dst = os.path.join(ctx.path.abspath(), SPORT_TYPES_HEADER)
    if not os.path.exists(dst) or open(dst).read() != content:
        with open(dst, 'w') as f:
            f.write(content)


def build(ctx):
    ctx.load('pebble_sdk')
    generate_sport_types_header(ctx)

    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app')
        binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json']),
                   js_entry_file='src/pkjs/index.js')
