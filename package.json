{
  "name": "pebble-workout-export",
  "author": "Alar Mäerand",
  "version": "0.7.0",
  "keywords": [
    "pebble-app"
  ],
  "private": true,
  "dependencies": {},
  "pebble": {
    "displayName": "Workout Export",
    "uuid": "9d2c6d1a-ed46-4cc8-96f9-e9591143596c",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "emery",
      "flint",
      "gabbro"
    ],
    "capabilities": [
      "health",
      "configurable"
    ],
    "usesPermissions": [
      {
        "name": "Internet",
        "parameters": {
          "domains": [
            "intervals.icu",
            "www.strava.com"
          ]
        }
      }
    ],
    "watchapp": {
      "watchface": false
    },
    "messageKeys": [
      "Command",
      "StartTime",
      "EndTime",
      "PebbleActivity",
      "SportType",
      "DistanceM",
      "Calories",
      "Minutes",
      "ChunkOffset",
      "HeartRates",
      "Steps",
      "Favorites",
      "DefaultRun",
      "DefaultWalk",
      "DefaultWorkout",
      "StravaConnected",
      "Status",
      "StatusText"
    ],
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "IMAGE_MENU_ICON",
          "file": "images/menu_icon.png",
          "menuIcon": true
        }
      ]
    }
  }
}
